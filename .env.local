# 站点配置
NEXT_PUBLIC_SITE_NAME=意见反馈系统

# API 配置
NEXT_PUBLIC_API_URL=/api

# 网络访问配置（开发环境）
# 当需要从其他设备访问时，将 SITE_URL 改为你的 Windows IP
NEXT_PUBLIC_SITE_URL=http://172.30.16.95:3001

# 开发环境示例
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
# NEXT_PUBLIC_API_URL=/api

# 生产环境示例（部署时取消注释并修改为实际域名）
# NEXT_PUBLIC_SITE_URL=https://feedback.your-domain.com
# NEXT_PUBLIC_API_URL=https://api.your-domain.com
