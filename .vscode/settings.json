{
  // Tailwind CSS IntelliSense 配置
  "tailwindCSS.includeLanguages": {
    "javascriptreact": "html",
    "typescriptreact": "html",
    "vue": "html",
    "javascript": "javascriptreact",
    "typescript": "typescriptreact"
  },
  "tailwindCSS.experimental.classRegex": [
    "className\\s*=\\s*[\"'`]([^\"'`]*)[\"'`]",
    "class\\s*=\\s*[\"'`]([^\"'`]*)[\"'`]",
    [
      "(?:dark|sm|md|lg|xl|2xl|hover|focus|active|disabled|first|last|odd|even|group-hover):([a-zA-Z0-9-_]+)",
      "$1"
    ]
  ],
  // Tailwind 功能配置
  "tailwindCSS.validate": true,
  "tailwindCSS.suggestions": true,
  "tailwindCSS.hovers": true,
  "tailwindCSS.colorDecorators": true,
  "tailwindCSS.emmetCompletions": true,
  "tailwindCSS.showPixelEquivalents": true,
  "tailwindCSS.rootFontSize": 16,
  // TypeScript React 文件支持
  "editor.quickSuggestions": {
    "other": true,
    "comments": false,
    "strings": true
  },
  "editor.hover.enabled": true,
  // CSS 支持
  "css.validate": true,
  "css.hover.documentation": true,
  // Tailwind 文档快速访问
  "tailwind-docs.openIn": "editor",
  "tailwindCSS.lint.cssConflict": "warning",
  "tailwindCSS.lint.invalidApply": "error",
  "tailwindCSS.lint.invalidScreen": "error",
  "tailwindCSS.lint.invalidVariant": "error",
  "tailwindCSS.lint.invalidConfigPath": "error",
  "tailwindCSS.lint.invalidTailwindDirective": "error",
  // 编辑器配置
  "editor.suggest.showStatusBar": true,
  "editor.inlineSuggest.enabled": true,
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.codeActionsOnSave": {
    "source.fixAll": "explicit"
  },
  // 语言特定的格式化器
  "[typescript]": {
    "editor.defaultFormatter": "vscode.typescript-language-features"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "vscode.typescript-language-features"
  },
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[javascriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  // TypeScript 和语言支持
  "typescript.suggest.autoImports": true,
  "typescript.updateImportsOnFileMove.enabled": "always",
  "typescript.preferences.includePackageJsonAutoImports": "on",
  // CSS Peek 设置
  "css_peek.enable": true,
  "css_peek.searchFileExtensions": [
    ".css",
    ".scss",
    ".sass",
    ".less"
  ],
  "css_peek.peekFromLanguages": [
    "html",
    "javascript",
    "typescript",
    "jsx",
    "tsx"
  ],
  // CSS Navigation 设置  
  "cssNavigation.enableGoToDefinition": true,
  "cssNavigation.enableFindAllReferences": true,
  "headwind.runOnSave": true,
  // 文件关联
  "files.associations": {
    "*.css": "tailwindcss",
    "*.tsx": "typescriptreact"
  },
  // Emmet 支持
  "emmet.includeLanguages": {
    "typescript": "html",
    "typescriptreact": "html",
    "javascript": "html",
    "javascriptreact": "html"
  },
  // 端口转发设置
  "remote.portsAttributes": {
    "3000": {
      "visibility": "public",
      "label": "Next.js Development Server"
    }
  },
  "[dockercompose]": {
    "editor.defaultFormatter": "docker.docker"
  }
}