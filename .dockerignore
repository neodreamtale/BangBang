# 排除不需要的文件和目录
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Next.js 构建输出
.next/
out/

# 生产环境不需要的文件
README.md
learn/
BIDLINK_DEBUG.md
CONSOLE_DEBUG_GUIDE.md
.gitignore
.eslintrc.json

# 环境变量文件
.env*.local
.env.development
.env.test

# 测试文件
**/*.test.js
**/*.test.ts
**/*.test.tsx
**/*.spec.js
**/*.spec.ts
**/*.spec.tsx
coverage/

# IDE 和编辑器文件
.vscode/
.idea/
*.swp
*.swo
*~

# OS 生成的文件
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# 日志文件
logs
*.log

# Docker 相关
Dockerfile
.dockerignore
docker-compose*.yml

# Dev Container 配置（生产环境不需要）
.devcontainer/

# Git
.git/
.gitignore

