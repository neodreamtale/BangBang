{
  "name": "punch",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack --port 3001 --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "analyze-files": "npx tsx scripts/analyze-unused-files.ts",
    "clean-files": "npx tsx scripts/clean-unused-files.ts",
    "manage-files": "npx tsx scripts/manage-files.ts",
    "docker:build": "docker build -t punch-feedback-app .",
    "docker:run": "docker run -p 3001:3001 punch-feedback-app",
    "docker:dev": "docker-compose up --build",
    "docker:prod": "docker-compose up -d --build",
    "docker:logs": "docker logs punch-app",
    "docker:stop": "docker stop punch-app",
    "docker:clean": "docker system prune -f"
  },
  "dependencies": {
    "@types/glob": "^8.1.0",
    "glob": "^11.0.3",
    "lucide-react": "^0.525.0",
    "next": "15.4.3",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.4.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}