{
  "name": "punch",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "setup": "npm install && npx prisma generate && npx prisma db push",
    "db:setup": "npx prisma generate && npx prisma db push",
    "db:reset": "npx prisma db push --force-reset && npx prisma generate",
    "analyze-files": "npx tsx scripts/analyze-unused-files.ts",
    "clean-files": "npx tsx scripts/clean-unused-files.ts",
    "manage-files": "npx tsx scripts/manage-files.ts",
    "docker:build": "docker build -t punch-feedback-app .",
    "docker:run": "docker run -p 3001:3001 punch-feedback-app",
    "docker:dev": "docker-compose -f docker-compose.dev.yml up --build",
    "docker:dev:logs": "docker-compose -f docker-compose.dev.yml logs -f",
    "docker:prod": "docker-compose up -d --build",
    "docker:logs": "docker logs punch-app",
    "docker:stop": "docker stop punch-app",
    "docker:clean": "docker system prune -f"
  },
  "dependencies": {
    "@prisma/client": "^6.13.0",
    "@types/glob": "^8.1.0",
    "glob": "^11.0.3",
    "lucide-react": "^0.525.0",
    "next": "^15.4.8",
    "prisma": "^6.13.0",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4.1.11",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.21",
    "eslint": "^9",
    "eslint-config-next": "15.4.3",
    "prettier": "^3.6.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5"
  }
}